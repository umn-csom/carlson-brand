/**
 * Implements hook_wysiwyg_plugin() to enable the xhtmlxtras plugin for tinymce.
 *
 * @see hook_wysiwyg_include_directory()
 *
 * @param $editor
 *   The internal name of the currently processed editor.
 * @param $version
 *   The version of the currently processed editor.
 *
 * @return
 *   An associative array of plugin info keyed on plugin name.
 */
function umn_wysiwyg_wysiwyg_plugin($editor, $version) {
  $libs = wysiwyg_get_libraries();
  if ($editor == 'tinymce') {
    return array(
      'xhtmlxtras' => array(
        'path' => $libs['tinymce'] . '/jscripts/tiny_mce/plugins/xhtmlxtras/',
        'buttons' => array(
          'cite' => t('Citation'),
          'del' => t('Deleted'),
          'abbr' => t('Abbreviation'),
          'acronym' => t('Acronym'),
          'ins' => t('Inserted'),
          'attribs' => t('HTML attributes'),
        ),
        'url' => 'http://www.tinymce.com/wiki.php/Plugin:xhtmlxtras',
        'internal' => TRUE,
        'load' => TRUE,
      )
    );
  }
}