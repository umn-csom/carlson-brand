name = UMN basic settings
description = Basic settings for a umn site
core = 7.x
package = UMN Features
version = 7.x-1.0
project = umn_basic_settings
dependencies[] = ctools
dependencies[] = page_manager
dependencies[] = strongarm
features[ctools][] = page_manager:pages_default:1
features[ctools][] = strongarm:strongarm:1
features[defaultconfig][] = strongarm:admin_theme
features[defaultconfig][] = strongarm:node_admin_theme
features[defaultconfig][] = strongarm:theme_default
features[features_api][] = api:2
features[page_manager_handlers][] = site_template_panel_context
features[variable][] = panels_everywhere_site_template_enabled
features[variable][] = panels_page_default
features[variable][] = securepages_enable
features_exclude[dependencies][defaultconfig] = defaultconfig
