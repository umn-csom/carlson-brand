/**
 * Implements hook_flush_caches().
 */
function umn_d2d_migration_cbs_flush_caches() {
  umn_d2d_migration_cbs_register_migrations();

}


/**
 * Implements hook_register_migrations().
 */
function umn_d2d_migration_cbs_register_migrations() {
  $common_arguments = array(
    'source_connection' => 'cbs_old',
    'source_version' => 7,
  );


  $user_arguments = $common_arguments + array(
    'description' => t('Migration of users from old CBS'),
    'machine_name' => 'User',
  );

  Migration::registerMigration('DrupalUser7Migration', $user_arguments['machine_name'],
    $user_arguments);


}
