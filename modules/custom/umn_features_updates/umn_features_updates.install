/**
 * Helper function to prepare features revert array and revert features.
 */
function umn_features_updates_features_revert($features = array()) {
  //Features to revert.
  foreach ($features as $feature) {
    if (module_exists($feature)) {

      $info[] = $feature;
      $components = features_get_feature_components($feature);
      $revert[$feature] = array();
      //Set up data so that features can revert the featues.
      foreach ($components as $key => $component) {
        $revert[$feature][] = $key;
      }
    }
  }

  features_revert($revert);
  return $info;

}

/**
 * implements hook_install()
 */
function umn_features_updates_install() {

  $revert = umn_features_updates_2_21_14();
  watchdog('umn_features_updates', 'The following features have been reverted:
   <br />' . implode(', ', $revert) . '<br />');
}

/**
 * Reverts features that where changed for the code release on 2-21-14.
 */
function umn_features_updates_update_7001($sandbox) {
  $messages = array();
  $revert = umn_features_updates_2_21_14();
  return 'The following features have been reverted: <br />' . implode(', ', $revert) . '<br />';
}

/*
 * Reverts features that where changed for the code release on 2-21-14.
 */
function umn_features_updates_2_21_14() {
  //List of features that have been updated and that need to be reverted.
  $features = array();
  //Features that are common to both profile/site types.
  $features[] = 'umn_basic_settings';
  $features[] = 'umn_workbench';
  //Features that are only for umn.
  $features[] = 'umn_calendar_content_type';
  $features[] = 'umn_course_content_type';
  $features[] = 'umn_faculty_content_type';
  $features[] = 'umn_general_page_content_type';
  $features[] = 'umn_landing_page_content_type';
  $features[] = 'umn_news_content_type';
  $features[] = 'umn_staff_content_type';
  //Features that are only for umn_groups.
  $features[] = 'umn_groups_calendar_content_type';
  $features[] = 'umn_groups_course_content_type';
  $features[] = 'umn_groups_faculty_content_type';
  $features[] = 'umn_groups_landing_page_content_type';
  $features[] = 'umn_groups_news_content_type';
  $features[] = 'umn_groups_page_template';
  $features[] = 'umn_groups_staff_content_type';
  $features[] = 'umn_groups_group_content_type';

  $revert = array();
  $info = array();
  //Features to revert.
  foreach ($features as $feature) {
    if (module_exists($feature)) {

      $info[] = $feature;
      $components = features_get_feature_components($feature);
      $revert[$feature] = array();
      //Set up data so that features can revert the featues.
      foreach ($components as $key => $component) {
        $revert[$feature][] = $key;
      }
    }
  }

  features_revert($revert);
  return $info;
}

/**
 * Revert features that where changed for the code release on 2-27-14.
 */
function umn_features_updates_update_7002() {
  $messages = array();
  $features = array('umn_workbench');

  $revert = umn_features_udpates_features_revert($features);
  return 'The following features have been reverted: <br />' . implode(', ', $revert) . '<br />';
}
/**
 * Revert features that where changed for #22948.
 */
function umn_features_updates_update_7003() {
  $messages = array();
  $features = array('umn_groups_landing_page_content_type');

  $revert = umn_features_updates_features_revert($features);
  return 'The following features have been reverted: <br />' . implode(', ', $revert) . '<br />';
}

/**
 * Revert staff and faculty content types to add title to their panilizer settings.
 */
function umn_features_updates_update_7004() {
  $features = array();
  //Non organic groups
  $features[] = 'umn_faculty_content_type';
  $features[] = 'umn_staff_content_type';

  //Organic groups
  $features[] = 'umn_groups_staff_content_type';
  $features[] = 'umn_groups_faculty_content_type';

  $revert = umn_features_updates_features_revert($features);
  return 'The following features have been reverted: <br />' . implode(', ', $revert) . '<br />';
}

/**
 * Reverts News view.
 */
function umn_features_updates_update_7006(&$sandbox) {

  $features = array();
  $features[] = 'news';

  $revert = umn_features_updates_features_revert($features);

  return 'The following features have been reverted: <br />' . implode(', ', $revert) . '<br />';
}
